---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ASSET_VERSION, DEFAULT_OG, SUBSTACK, absolute } from "../data/site";
import "../styles/fonts.css";
import "../styles/style.css";

interface Props {
  title: string;
  description: string;
  path: string; // URL path without leading slash, "" for the home page
  base: "./" | "../" | "/"; // prefix from this page to the site root ("/" where the URL is unknown, as on the 404 page)
  ogType?: "website" | "article";
  ogImage?: string | null;
  robots?: string;
  published?: string;
  jsonLd: object;
  bodyClass?: string;
  shellClass?: string;
  shellAttrs?: Record<string, string>;
}

const {
  title,
  description,
  path,
  base,
  ogType = "website",
  ogImage,
  robots = "index, follow, max-image-preview:large",
  published,
  jsonLd,
  bodyClass,
  shellClass,
  shellAttrs = {},
} = Astro.props;

const url = absolute(path);
const image = absolute(ogImage ?? DEFAULT_OG);
// Escape "</" so the JSON can never close its <script> tag early.
const ld = JSON.stringify(jsonLd, null, 2).replace(/<\//g, "<\\/");
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Eren Turkoglu" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#151410" />
    <meta name="color-scheme" content="dark" />
    <meta name="google-site-verification" content="PYvdLfvQTmTyrYSIMaSIEzh_1ivh-MyN-sFsYylgiag" />
    <script is:inline>if(!matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("motion")</script>

    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {/* Google Search shows a favicon only if it is a multiple of 48px */}
    <link rel="icon" href={`${base}favicon-96x96.png`} sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title="DatabaseStory" href={`${SUBSTACK}/feed`} />

    <meta property="og:site_name" content="DatabaseStory" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published} />}
    {published && <meta property="article:author" content="Eren Turkoglu" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {/* The body text and interface fonts, fetched before the stylesheet asks for them */}
    <link rel="preload" href="/assets/fonts/newsreader-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/geist-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={ld} />
    <script is:inline async src="https://plausible.io/js/pa-srCjeYLgKjR6NLzibJJuc.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class={bodyClass}>
    <div class:list={["site-shell", shellClass]} {...shellAttrs}>
      <slot name="banner" />
      <Header base={base} />
      <slot />
    </div>
    <Footer base={base} />
    <script is:inline src={`${base}site.js?v=${ASSET_VERSION}`}></script>
  </body>
</html>
